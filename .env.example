# Database Configuration (Required for storing user data and analysis results)
DATABASE_URL="Your Database URL (e.g., file:./prisma/tradelab.db for SQLite or a connection string for PostgreSQL)"

# AI Key (Required for trade analysis)
# Get yours at https://aistudio.google.com/
NEXT_PUBLIC_GEMINI_API_KEY="Your Gemini API Key"

# Firebase Client Configuration (Required for user authentication and data storage)
NEXT_PUBLIC_FIREBASE_PROJECT_ID="Your Firebase Project ID"
NEXT_PUBLIC_FIREBASE_APP_ID="Your Firebase App ID"
# This key is ALSO read by the FastAPI backend (as NEXT_PUBLIC_FIREBASE_API_KEY or FIREBASE_API_KEY)
# to verify Firebase ID tokens via the Identity Toolkit REST API — no service account needed.
NEXT_PUBLIC_FIREBASE_API_KEY="Your Firebase API Key"
FIREBASE_API_KEY="Your Firebase API Key"   # Optional alias for the backend; falls back to NEXT_PUBLIC_FIREBASE_API_KEY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="Your Firebase Auth Domain"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="Your Firebase Storage Bucket"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="Your Firebase Messaging Sender ID"
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID="Your Firebase Measurement ID"
